# Copia a .env.local y completa con los datos de tu proyecto Firebase
# (Consola Firebase → Configuración del proyecto → Tus apps → Web).
# Son claves públicas del cliente; la seguridad la dan las reglas de firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_WORKER_URL=
